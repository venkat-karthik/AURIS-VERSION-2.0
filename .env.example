# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cloudinary Setup for Call Audio Recordings & Agent Avatars
CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET="auris_voice"

# Razorpay Payments Gateway Setup (Key ID & Secret from Razorpay Dashboard)
RAZORPAY_KEY_ID="rzp_test_sampleKey123"
RAZORPAY_KEY_SECRET=""

# Auris Voice Mesh Telephony Carrier (Plivo India)
PLIVO_AUTH_ID=""
PLIVO_AUTH_TOKEN=""
PLIVO_CALLER_ID="+918048799695"
AURIS_PUBLIC_URL="http://localhost:3000"

# Speech-to-Text & Text-to-Speech (Indic Speech Mesh)
SARVAM_API_KEY=""
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="centralindia"
